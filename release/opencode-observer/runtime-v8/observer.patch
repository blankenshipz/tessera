+import type { FinalWire } from "./terminal-boundary.js"
+
+/** The actual canonical authority connection is supplied by its enrolled owner.
+ * This module does not discover DB paths, credentials or manufacture actor records. */
+export interface CanonicalConnection {
+  exec(sql: string): unknown
+}
+export interface OwnedReservationCapability {
+  /** Must recheck this actual claim's reserved unit, not globalremaining>0.
+   * Must validate complete current lineage/finance/native checks and exact wire. */
+  assertCurrentExact(wire: FinalWire, operationRef: string): void
+}
+export interface CanonicalFenceOwner {
+  connection: CanonicalConnection
+  validateOwnedClaimSync(connection: CanonicalConnection, claim: object): OwnedReservationCapability
+}
+
+/** Trusted co-located owner constructor only; never a receipt/config selectable
+ * Boolean. Backend supplies its registered canonical synchronous validator. */
+export function makeCanonicalInvocationFence(owner: CanonicalFenceOwner) {
+  if (
+    !owner?.connection ||
+    typeof owner.connection.exec !== "function" ||
+    typeof owner.validateOwnedClaimSync !== "function"
+  )
+    throw new Error("canonical invocation fence unavailable")
+  const connection = owner.connection,
+    validate = owner.validateOwnedClaimSync
+  const consumed = new WeakSet<object>()
+  return Object.freeze({
+    runExact<A>(
+      freshClaim: object,
+      wire: FinalWire,
+      operationRef: string,
+      approved: { assertLiveForInvocation(wire: FinalWire, operationRef: string): void },
+      nativeInvoke: () => A,
+    ): A {
+      if (!freshClaim || consumed.has(freshClaim) || !/^[a-f0-9]{64}$/.test(operationRef))
+        throw new Error("canonical invocation replay denied")
+      let locked = false,
+        invoked = false
+      try {
+        connection.exec("BEGIN IMMEDIATE")
+        locked = true
+        // The SAME canonical DB write boundary serializes native invocation and
+        // every backend revoke/expiry/current grant/finance mutation transaction.
+        const reservation = validate(connection, freshClaim)
+        if (!reservation || typeof reservation.assertCurrentExact !== "function")
+          throw new Error("canonical reservation unavailable")
+        if (
+          reservation.assertCurrentExact(wire, operationRef) !== undefined ||
+          approved.assertLiveForInvocation(wire, operationRef) !== undefined
+        )
+          throw new Error("unknown asynchronous or Boolean liveness")
+        consumed.add(freshClaim)
+        invoked = true
+        // Call the actual primitive while lock held; a returned Promise is awaited
+        // OUTSIDE this lock by terminal executor. No DB+network exactly-once claim.
+        const result = nativeInvoke()
+        connection.exec("COMMIT")
+        locked = false
+        return result
+      } catch {
+        if (locked) {
+          try {
+            connection.exec("ROLLBACK")
+          } catch {}
+        }
+        // Claim is already durable/server-reserved. Never refund/remint after an
+        // invoked/unknown effect. Audit journal/settle must record uncertainty.
+        throw new Error(invoked ? "native invocation uncertain; reservation consumed" : "canonical invocation denied")
+      }
+    },
+  })
+}
