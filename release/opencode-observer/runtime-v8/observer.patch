+        for seconds in [-31, 10]:
+            data = self.snapshot()
+            data["checked_at"] = (
+                datetime.now(timezone.utc) + timedelta(seconds=seconds)
+            ).isoformat()
+            status, output = self.call(data, ["--check", "--receipt"])
