+"""Safe metadata for the exact snapshot used by the existing admission check."""
+
+from datetime import datetime, timedelta, timezone
+
+
+def make_check_receipt(snapshot, *, denied, now):
+    checked = datetime.fromisoformat(snapshot["checked_at"].replace("Z", "+00:00"))
+    if (
+        checked.tzinfo is None
+        or now.tzinfo is None
+        or not 0 <= (now - checked).total_seconds() < 30
+    ):
+        raise ValueError("quota receipt snapshot age unknown")
+    return {
+        "evidence_class": "local_measured_enforcement",
+        "outcome": "denied" if denied else "passed",
+        "checked_at": now.astimezone(timezone.utc).isoformat(),
+        "snapshot_checked_at": checked.isoformat(),
+        "valid_until": (checked + timedelta(seconds=30)).isoformat(),
+    }
