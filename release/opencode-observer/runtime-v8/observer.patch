+import { createHash } from "node:crypto"
+import { Effect } from "effect"
+
+// Only explicitly public structural policy fields; never serialize a request,
+// headers/options/body/account/connection identifiers, descriptions or defaults.
+const value = (object: unknown, key: string): unknown => {
+  if (object === null || typeof object !== "object") throw new Error("phase projection invalid")
+  const descriptor = Object.getOwnPropertyDescriptor(object, key)
+  if (!descriptor || !("value" in descriptor)) throw new Error("phase projection accessor denied")
+  return descriptor.value
+}
+const id = (input: unknown) => {
+  if (typeof input !== "string" || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$/.test(input))
+    throw new Error("phase identifier invalid")
+  return input
+}
+// Called only with freshly constructed public projection objects above, not raw
+// requests. Sorted-key canonical JSON matches the Tessera phase fingerprint.
+const canonical = (input: unknown): unknown => {
+  if (Array.isArray(input)) return input.map(canonical)
+  if (input !== null && typeof input === "object")
+    return Object.fromEntries(
+      Object.keys(input)
+        .sort()
+        .map((key) => [key, canonical(value(input, key))]),
+    )
+  return input
+}
+const digest = (input: unknown) =>
+  createHash("sha256")
+    .update(JSON.stringify(canonical(input)))
+    .digest("hex")
+const schemaPolicy = (input: unknown, depth = 0): unknown => {
+  if (depth > 8) throw new Error("phase schema bound")
+  const type = value(input, "type")
+  if (!["object", "array", "string", "number", "integer", "boolean", "null"].includes(type as string))
+    throw new Error("phase schema type unknown")
+  if (type === "object") {
+    const fields = value(input, "properties")
+    if (!fields || typeof fields !== "object") throw new Error("phase properties unknown")
+    const keys = Object.keys(fields).sort()
+    if (keys.length > 128) throw new Error("phase properties bound")
+    return { type, properties: keys.map((key) => [id(key), schemaPolicy(value(fields, key), depth + 1)]) }
+  }
+  if (type === "array") return { type, items: schemaPolicy(value(input, "items"), depth + 1) }
+  return { type }
+}
+
+export type Challenge = {
+  nonce: string
+  session_ref: string
+  proof_ref: string
+  issuer_origin: string
+}
+export type SafeInput = { provider: unknown; model_id: unknown; tools: unknown }
+export type Lease = ReturnType<ModelPhaseOrder["capture"]>
+
+export class ModelPhaseOrder {
+  private revision = 1
+  get currentRevision() {
+    return this.revision
+  }
+  assertCurrent(ticket: { revision: number; sequence: number }) {
+    if (ticket.revision !== this.revision || ticket.sequence !== this.sequence) throw new Error("phase ticket drift")
+  }
+  private sequence = 0
+  private nonces = new Set<string>()
+  changed() {
+    this.revision += 1
+  }
+
+  // This is the core ordered executor, not a plugin-reported ordering assertion.
+  // Hook registration/disposal while an execution is suspended invalidates it.
+  execute<T, R = never>(
+    event: T,
+    hooks: readonly ((event: T) => Effect.Effect<void, never, R>)[],
+    challenge?: Challenge,
+  ) {
+    const order = this
+    return Effect.gen(function* () {
+      const revision = order.revision
+      const sequence = ++order.sequence
+      if (challenge) {
+        const refs = Object.fromEntries(
+          ["nonce", "session_ref", "proof_ref"].map((key) => {
+            const ref = value(challenge, key)
+            if (typeof ref !== "string" || !/^[a-f0-9]{64}$/.test(ref)) throw new Error("phase challenge invalid")
+            return [key, ref]
+          }),
+        )
+        Object.defineProperty(event, "phaseContext", {
+          value: Object.freeze({ ...refs, order_revision: revision, sequence }),
+          writable: false,
+          configurable: false,
+        })
+      }
+      const snapshot = [...hooks]
+      for (const hook of snapshot) {
+        yield* hook(event)
+        if (revision !== order.revision || sequence !== order.sequence) throw new Error("model hook order drift")
+      }
+      return { event, ticket: Object.freeze({ revision, sequence }) }
+    })
+  }
+
+  capture(
+    ticket: { revision: number; sequence: number },
+    challenge: Challenge,
+    read: () => SafeInput,
+    clock = () => Date.now(),
+  ) {
+    const hash = /^[a-f0-9]{64}$/
+    for (const field of ["nonce", "session_ref", "proof_ref"] as const)
+      if (typeof value(challenge, field) !== "string" || !hash.test(value(challenge, field) as string))
+        throw new Error("phase challenge invalid")
+    const originValue = value(challenge, "issuer_origin")
+    if (typeof originValue !== "string") throw new Error("phase origin invalid")
+    const origin = new URL(originValue)
+    if (
+      origin.protocol !== "https:" ||
+      origin.username ||
+      origin.password ||
+      origin.search ||
+      origin.hash ||
+      origin.pathname !== "/"
+    )
+      throw new Error("phase origin invalid")
+    if (this.nonces.has(challenge.nonce) || this.nonces.size >= 4096) throw new Error("phase nonce replay or bound")
+    this.nonces.add(challenge.nonce)
+    const project = () => {
+      const input = read()
+      const provider = id(value(input, "provider"))
+      if (provider !== "openai") throw new Error("phase provider unknown")
+      const model_id = id(value(input, "model_id"))
+      const tools = value(input, "tools")
+      if (!Array.isArray(tools) || tools.length > 128) throw new Error("phase tools bound")
+      const policy = Array.from({ length: tools.length }, (_, index) => value(tools, String(index)))
+        .map((tool) => ({ name: id(value(tool, "name")), schema: schemaPolicy(value(tool, "inputSchema")) }))
+        .sort((a, b) => a.name.localeCompare(b.name))
+      if (new Set(policy.map((tool) => tool.name)).size !== policy.length) throw new Error("phase duplicate tools")
+      const projection = {
+        provider,
+        model_id,
+        provider_sha256: digest({ provider }),
+        model_sha256: digest({ provider, model_id }),
+        tool_policy_sha256: digest(policy),
+      }
+      return {
+        ...projection,
+        fingerprint: digest({
+          phase: "post-model-request-hooks",
+          order_revision: ticket.revision,
+          sequence: ticket.sequence,
+          ...projection,
+        }),
+      }
+    }
+    if (ticket.revision !== this.revision || ticket.sequence !== this.sequence) throw new Error("phase ticket drift")
+    const observed = clock()
+    const projection = Object.freeze(project())
+    const receipt = Object.freeze({
+      protocol: "opencode-model-hook-phase-v1",
+      phase: "post-model-request-hooks",
+      complete: false,
+      // The stage's executor is ordered, but no final HTTP/transport claim exists.
+      phase_finality: "unproven",
+      ordering_enforced: false,
+      nonce: challenge.nonce,
+      session_ref: challenge.session_ref,
+      proof_ref: challenge.proof_ref,
+      issuer_origin: origin.origin,
+      order_revision: ticket.revision,
+      sequence: ticket.sequence,
+      observed_at: new Date(observed).toISOString(),
+      valid_until: new Date(observed + 30000).toISOString(),
+      projection,
+      local_enforcement: Object.freeze({
+        evidence_class: "local_measured_enforcement",
+        model_request_hook_executor: "ordered_snapshot",
+        scope: "model-request-hook-stage-only",
+      }),
+      financial_settings: Object.freeze({
+        evidence_class: "operator_attested_financial_settings",
+        observation: "not_supplied",
+        freshness: "unknown",
+      }),
+      provider_facts: Object.freeze({
+        evidence_class: "provider_unknown",
+        entitlement: "unknown",
+        billing_guarantee: "unknown",
+      }),
+    })
+    let consumed = false
+    const readReceipt = () => {
+      const now = clock()
+      if (
+        consumed ||
+        now < observed ||
+        now >= observed + 30000 ||
+        ticket.revision !== this.revision ||
+        ticket.sequence !== this.sequence ||
+        project().fingerprint !== projection.fingerprint
+      )
+        throw new Error("phase receipt invalidated")
+      return receipt
+    }
+    return Object.freeze({
+      receipt,
+      read: readReceipt,
+      consume: () => {
+        readReceipt()
+        consumed = true
+        return receipt
+      },
+    })
+  }
+}
