+import http from 'node:http';
+import path from 'node:path';
+
+/** Owner registers this IPC server explicitly. It never discovers credentials,
+ * starts an OpenCode session server or changes socket/security configuration. */
+export async function serveOwnerProofIPC({ socketPath, producer, authenticatedOwnerReader }) {
+  if (typeof socketPath !== 'string' || !path.isAbsolute(socketPath) ||
+      typeof authenticatedOwnerReader !== 'function' || typeof producer?.resolveCheck !== 'function')
+    throw new Error('owner proof IPC registration missing');
+  const server = http.createServer(async (request, response) => {
+    try {
+      if (request.method !== 'POST' || request.url !== '/resolve-native-check') throw new Error();
+      const reader = await authenticatedOwnerReader(request);
+      if (!reader || typeof reader.assertCurrentPublisher !== 'function') throw new Error();
+      let bytes = 0; const chunks = [];
+      for await (const chunk of request) { bytes += chunk.length; if (bytes > 2048) throw new Error(); chunks.push(chunk); }
+      const body = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+      if (Object.keys(body).sort().join(',') !== 'local_check_ref,quota_check_ref') throw new Error();
+      const proof = producer.resolveCheck(body.local_check_ref, body.quota_check_ref);
+      if ((await reader.assertCurrentPublisher(proof.publisher_ref)) !== undefined) throw new Error();
+      response.writeHead(200, { 'Content-Type': 'application/json' }); response.end(JSON.stringify(proof));
+    } catch {
+      response.writeHead(403, { 'Content-Type': 'application/json' }); response.end('{"code":"owner_check_denied"}');
+    }
+  });
+  await new Promise((resolve, reject) => { server.once('error', reject); server.listen(socketPath, resolve); });
+  return Object.freeze({ close: () => new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve())) });
+}
+
+/** Secure reader handle applies its existing enrolled publisher authentication.
+ * IPC readback is check provenance, never a postclaim liveness or dispatch permit. */
+export function readOwnerProofIPC({ socketPath, local_check_ref, quota_check_ref, ownerHandle }) {
+  if (typeof ownerHandle?.authorizeExistingRequest !== 'function') return Promise.reject(new Error('secure proof reader missing'));
+  return new Promise((resolve, reject) => {
+    const body = JSON.stringify({ local_check_ref, quota_check_ref });
+    const request = http.request({ socketPath, path: '/resolve-native-check', method: 'POST',
+      headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body), 'Connection': 'close' } }, response => {
+      let size = 0; const chunks = [];
+      response.on('data', chunk => { size += chunk.length; if (size > 32768) request.destroy(); else chunks.push(chunk); });
+      response.on('end', () => {
+        try { if (response.statusCode !== 200 || size > 32768) throw new Error(); resolve(JSON.parse(Buffer.concat(chunks).toString('utf8'))); }
+        catch { reject(new Error('owner proof IPC denied or unavailable')); }
+      });
+    });
+    request.setTimeout(5000, () => request.destroy());
+    request.on('error', () => reject(new Error('owner proof IPC denied or unavailable')));
+    try { ownerHandle.authorizeExistingRequest(request); request.end(body); }
+    catch { request.destroy(); reject(new Error('secure proof reader unavailable')); }
+  });
+}
