+export interface CurrentAuthority {
+  readonly principal: object
+  readonly binding: TerminalBinding
+  /** Issuer-issued live capability method, never reconstructed from serialized
+   * authorized/verified state. Must synchronously deny changed/revoked scope. */
+  readonly assertLiveAtInvocation: () => void
+}
+export interface NativeQuota {
+  readonly checked_at: number
+  readonly snapshot_checked_at: number
+  readonly valid_until: number
+}
+/** Returned by the enrolled v2 verifier bridge, never a serialized pass flag. */
+export interface VerifiedTerminalCapability {
+  readonly assertLiveForInvocation: (wire: FinalWire, operation_ref: string) => void
+}
+/** Allowlisted diagnostic DTO only; NEVER an executable capability or authority. */
+export interface TerminalDispatchRecord extends TerminalBinding {
+  readonly protocol: "opencode-terminal-dispatch-v2"
+  readonly operation_ref: string
