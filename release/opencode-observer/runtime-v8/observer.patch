+"""Authenticated owner client. Readbacks/audit state are NEVER native permits."""
+from __future__ import annotations
+
+import re
+import sqlite3
+from pathlib import Path
+from urllib.parse import urlparse
+from urllib.request import Request, HTTPRedirectHandler, build_opener
+
+from tessera_control.runtime_binding_models import (
+    AllocateRuntimeOperation, ClaimRuntimeOperation, ResolveRuntimeBinding,
+    RuntimeBindingSnapshot, RuntimeClaimReceipt, RuntimeOperation, SettleRuntimeOperation,
+)
+
+
+class RuntimeClientDenied(RuntimeError):
+    pass
+
+
+class NoRedirect(HTTPRedirectHandler):
+    def redirect_request(self, *args, **kwargs):
+        raise RuntimeClientDenied("control_redirect_denied")
+
+
+class NativeAuditJournal:
+    """Durable conservative crash fence only; canonical server owns authority."""
+
+    def __init__(self, path: Path):
+        if path.is_symlink() or any(parent.is_symlink() for parent in path.parents):
+            raise RuntimeClientDenied("journal_path_denied")
+        self.path = path
+        with sqlite3.connect(path) as db:
+            db.execute("CREATE TABLE IF NOT EXISTS native_audit(operation TEXT PRIMARY KEY, root TEXT NOT NULL, state TEXT NOT NULL)")
+
+    def before_claim(self, operation: str, root: str):
+        with sqlite3.connect(self.path, isolation_level=None) as db:
+            db.execute("BEGIN IMMEDIATE")
+            if db.execute("SELECT 1 FROM native_audit WHERE operation=? OR (root=? AND state IN ('pending','claimed','uncertain'))", (operation, root)).fetchone():
+                raise RuntimeClientDenied("claim_replay_or_uncertain")
+            db.execute("INSERT INTO native_audit VALUES(?,?,'pending')", (operation, root))
+            db.commit()
+
+    def record(self, operation: str, state: str):
+        if state not in {"claimed", "native-returned", "uncertain"}:
+            raise RuntimeClientDenied("audit_state_denied")
+        with sqlite3.connect(self.path) as db:
+            row = db.execute("SELECT state FROM native_audit WHERE operation=?", (operation,)).fetchone()
+            if row and row[0] == state and state in {"native-returned", "uncertain"}:
+                return  # Audit readback only; cannot dispatch or clear uncertainty.
+            if not row or row[0] in {"native-returned", "uncertain"}:
+                raise RuntimeClientDenied("audit_replay_denied")
+            db.execute("UPDATE native_audit SET state=? WHERE operation=?", (state, operation))
+
+
+class RuntimeControlClient:
+    def __init__(self, base_url: str, owner_handle, journal: NativeAuditJournal, *, audience="control", opener=None):
+        url = urlparse(base_url)
+        if (url.scheme != "https" and not (url.scheme == "http" and url.hostname in {"127.0.0.1", "::1"})) or url.username or url.password or url.query or url.fragment:
+            raise RuntimeClientDenied("control_destination_denied")
+        if audience not in {"control", "worker"} or not callable(getattr(owner_handle, "authorize_existing_request", None)):
+            raise RuntimeClientDenied("secure_owner_handle_missing")
+        self.base = base_url.rstrip("/") + ("/worker" if audience == "worker" else "")
+        self.owner, self.journal, self.opener = owner_handle, journal, opener or build_opener(NoRedirect()).open
+
+    def _post(self, path, payload, key, result_type):
+        if not isinstance(key, str) or not re.fullmatch(r"[A-Za-z0-9._:-]{1,128}", key):
+            raise RuntimeClientDenied("idempotency_key_denied")
+        request = Request(self.base + path, data=payload.model_dump_json().encode(), method="POST",
+                          headers={"Content-Type": "application/json", "Idempotency-Key": key})
+        # The already-owned secure handle applies native publisher authentication;
+        # no env/keychain/config/token discovery or secret value is returned here.
+        try:
+            self.owner.authorize_existing_request(request)
+            if request.full_url != self.base + path or request.get_method() != "POST":
+                raise RuntimeClientDenied("owner_request_destination_changed")
+            with self.opener(request, timeout=10) as response:
+                raw = response.read(65537)
+                if len(raw) > 65536:
+                    raise RuntimeClientDenied("response_size_denied")
+                status = response.status
+                result = result_type.model_validate_json(raw)
+        except Exception:
+            raise RuntimeClientDenied("control_request_failed_or_uncertain") from None
+        return status, result
+
+    def resolve(self, payload: ResolveRuntimeBinding, key: str):
+        status, result = self._post("/runtime-bindings/resolve", payload, key, RuntimeBindingSnapshot)
+        if status != 200:
+            raise RuntimeClientDenied("resolve_status_denied")
+        return result
+
+    def allocate(self, payload: AllocateRuntimeOperation, key: str):
+        status, operation = self._post("/runtime-operations", payload, key, RuntimeOperation)
+        if status != 201 or operation.state != "allocated" or operation.expected != payload:
+            raise RuntimeClientDenied("allocation_readback_not_new_authority")
+        return operation
+
+    def claim(self, operation: RuntimeOperation, payload: ClaimRuntimeOperation, key: str):
+        self.journal.before_claim(operation.operation_ref, operation.root_ref)
+        try:
+            status, receipt = self._post(f"/runtime-operations/{operation.operation_ref}/claim", payload, key, RuntimeClaimReceipt)
+            if status != 201 or receipt.delivery != "first-claim" or receipt.state != "claimed":
+                raise RuntimeClientDenied("claim_readback_not_permit")
+            for field in ("nonce", "ticket", "pins", "request_ref", "final_fingerprint", "financial_ref", "local_check_ref", "quota_check_ref", "order_revision", "sequence"):
+                if getattr(receipt, field) != getattr(payload, field):
+                    raise RuntimeClientDenied("claim_binding_mismatch")
+            if receipt.operation_ref != operation.operation_ref or receipt.root_ref != operation.root_ref or receipt.scope != operation.binding.scope:
+                raise RuntimeClientDenied("claim_scope_mismatch")
+            if receipt.reserved_native_operations != 1 or receipt.scope.grant_revision != payload.expected_grant_revision or receipt.scope.grant_epoch != payload.expected_grant_epoch:
+                raise RuntimeClientDenied("claim_reservation_mismatch")
+        except Exception:
+            self.journal.record(operation.operation_ref, "uncertain")
+            raise RuntimeClientDenied("claim_uncertain_no_retry") from None
+        self.journal.record(operation.operation_ref, "claimed")
+        # A receipt is not executable. Caller MUST obtain reviewed co-located fence
+        # and exact verifier capability; remaining budget0 is this owned reservation.
+        return receipt
+
+    def settle(self, operation_ref: str, payload: SettleRuntimeOperation, key: str):
+        if not re.fullmatch(r"[a-f0-9]{64}", operation_ref):
+            raise RuntimeClientDenied("operation_reference_denied")
+        try:
+            status, result = self._post(f"/runtime-operations/{operation_ref}/settle", payload, key, RuntimeOperation)
+            if status != 200 or result.operation_ref != operation_ref or result.state != payload.disposition:
+                raise RuntimeClientDenied("settlement_mismatch")
+        except Exception:
+            self.journal.record(operation_ref, "uncertain")
+            raise RuntimeClientDenied("settlement_uncertain_no_retry") from None
+        self.journal.record(operation_ref, payload.disposition)
+        return result
