+import { Context, Effect } from "effect"
+import type { Challenge, Lease } from "../plugin/model-phase.js"
+import { SessionModelRequest } from "./model-request.js"
+
+// Required trusted adapter to existing authenticated server/session ownership.
+// No default authorization, bearer parsing, caller approval boolean or new port.
+export class ModelPhaseAuthority extends Context.Service<
+  ModelPhaseAuthority,
+  {
+    authorizeSession: (sessionID: string) => Effect.Effect<{
+      principal: object
+      session_ref: string
+    }>
+  }
+>()("@opencode/ModelPhaseAuthority") {}
+
+export function makeModelPhaseChannel() {
+  const pending = new Map<
+    string,
+    { sessionID: string; principal: object; lease: Lease; prepared: SessionModelRequest.Prepared }
+  >()
+  const used = new Set<string>()
+  const authorize = (sessionID: string) =>
+    Effect.gen(function* () {
+      const authority = yield* ModelPhaseAuthority
+      return yield* authority.authorizeSession(sessionID)
+    })
+  const find = (sessionID: string, nonce: string) =>
+    Effect.gen(function* () {
+      const owner = yield* authorize(sessionID)
+      const entry = pending.get(nonce)
+      if (
+        !entry ||
+        entry.sessionID !== sessionID ||
+        entry.principal !== owner.principal ||
+        entry.lease.receipt.session_ref !== owner.session_ref
+      )
+        throw new Error("phase channel unauthorized or absent")
+      return entry
+    })
+  return Object.freeze({
+    prepare: (sessionID: string, challenge: Challenge, input: SessionModelRequest.Input) =>
+      Effect.gen(function* () {
+        const owner = yield* authorize(sessionID)
+        const fields = ["nonce", "session_ref", "proof_ref", "issuer_origin"]
+        if (
+          Object.keys(challenge).length !== fields.length ||
+          fields.some((field) => {
+            const descriptor = Object.getOwnPropertyDescriptor(challenge, field)
+            return !descriptor || !("value" in descriptor) || typeof descriptor.value !== "string"
+          })
+        )
+          throw new Error("phase channel challenge closed fields required")
+        if (
+          input.session.id !== sessionID ||
+          challenge.session_ref !== owner.session_ref ||
+          !/^[a-f0-9]{64}$/.test(challenge.nonce)
+        )
+          throw new Error("phase channel session binding invalid")
+        if (used.has(challenge.nonce) || used.size >= 4096) throw new Error("phase channel nonce replay or bound")
+        used.add(challenge.nonce)
+        const service = yield* SessionModelRequest.Service
+        const prepared = yield* service.primary({ ...input, phaseChallenge: challenge })
+        const current = yield* authorize(sessionID)
+        if (
+          current.principal !== owner.principal ||
+          current.session_ref !== owner.session_ref ||
+          !prepared.phaseEvidence
+        )
+          throw new Error("phase channel ownership changed")
+        const receipt = prepared.phaseEvidence.read()
+        pending.set(challenge.nonce, { sessionID, principal: owner.principal, lease: prepared.phaseEvidence, prepared })
+        return receipt
+      }),
+    read: (sessionID: string, nonce: string) => find(sessionID, nonce).pipe(Effect.map((entry) => entry.lease.read())),
+    // Receipt APIs never return the native request. Only a privileged in-process
+    // continuation receives it after current live-order consumption succeeds.
+    consume: (
+      sessionID: string,
+      nonce: string,
+      continuePrepared?: (prepared: SessionModelRequest.Prepared) => Effect.Effect<void>,
+    ) =>
+      Effect.gen(function* () {
+        const entry = yield* find(sessionID, nonce)
+        pending.delete(nonce)
+        const receipt = entry.lease.consume()
+        if (continuePrepared) yield* continuePrepared(entry.prepared)
+        return receipt
+      }),
+  })
+}
+
+export type ModelPhaseChannel = ReturnType<typeof makeModelPhaseChannel>
