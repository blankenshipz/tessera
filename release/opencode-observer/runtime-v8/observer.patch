+test("phase fingerprint matches Tessera sorted-key compact JSON contract", async () => {
+  const order = new ModelPhaseOrder(),
+    { ticket } = await run(order, {})
+  const receipt = order.capture(ticket, challenge(), safe).consume()
+  const { fingerprint, ...projection } = receipt.projection
+  const projected = {
+    phase: receipt.phase,
+    order_revision: receipt.order_revision,
+    sequence: receipt.sequence,
+    ...projection,
+  }
+  const native = spawnSync(
+    "python3",
+    [
+      "-c",
+      "import sys,json,hashlib;print(hashlib.sha256(json.dumps(json.loads(sys.argv[1]),sort_keys=True,separators=(',',':')).encode()).hexdigest())",
+      JSON.stringify(projected),
+    ],
+    { encoding: "utf8", env: { PATH: process.env.PATH, PYTHONDONTWRITEBYTECODE: "1" } },
+  )
+  expect(native.status).toBe(0)
+  expect(native.stdout.trim()).toBe(fingerprint)
+})
