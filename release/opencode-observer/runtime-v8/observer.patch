+import { expect, test } from 'bun:test';
+import { spawn } from 'node:child_process';
+import readline from 'node:readline';
+import { fileURLToPath } from 'node:url';
+
+const launcher = fileURLToPath(new URL('../bin/native-invocation-pipe.mjs', import.meta.url));
+const fixture = fileURLToPath(new URL('./synthetic-pipe-owner.mjs', import.meta.url));
+function child(mode, resource = '/SYNTHETIC/OWNED') {
+  return new Promise((resolve, reject) => {
+    const process = spawn(globalThis.process.execPath, [launcher, fixture], {
+      env: { PATH: '/usr/bin:/bin', TESSERA_RUNTIME_RESOURCE_FILE: resource }, stdio: ['pipe', 'pipe', 'pipe'],
+    });
+    let stderr = ''; const frames = [];
+    const timer = setTimeout(() => { process.kill('SIGKILL'); reject(new Error('synthetic pipe deadline')); }, 3000);
+    process.stderr.on('data', data => { stderr += data.toString(); });
+    process.on('error', error => { clearTimeout(timer); reject(error); });
+    readline.createInterface({ input: process.stdout }).on('line', line => {
+      const frame = JSON.parse(line); frames.push(frame);
+      if (frame.event !== 'ready') return;
+      if (mode === 'lost') { process.stdin.end(); return; }
+      if (mode === 'wrong') { process.stdin.write('{"event":"invoke","operation_ref":"' + 'd'.repeat(64) + '"}\n'); return; }
+      if (mode === 'extra') { process.stdin.write('{"event":"invoke","operation_ref":"' + frame.operation_ref + '","authorized":true}\n'); return; }
+      process.stdin.write(JSON.stringify({ event: 'invoke', operation_ref: frame.operation_ref }) + '\n');
+    });
+    process.on('close', code => { clearTimeout(timer); resolve({ code, frames, stderr }); });
+  });
+}
+test('real separate child metadata pipe returns only after synthetic native primitive inside owner lock', async () => {
+  const result = await child('invoke');
+  expect(result.code).toBe(0); expect(result.frames.map(frame => frame.event)).toEqual(['ready', 'native-returned']);
+  expect(result.stderr.match(/SYNTHETIC_NATIVE_EFFECT/g)).toHaveLength(1);
+});
+for (const mode of ['lost', 'wrong', 'extra']) test(`real separate pipe ${mode} denies without native effect`, async () => {
+  const result = await child(mode);
+  expect(result.code).toBe(1); expect(result.frames.map(frame => frame.event)).toEqual(['ready']);
+  expect(result.stderr).not.toContain('SYNTHETIC_NATIVE_EFFECT');
+});
