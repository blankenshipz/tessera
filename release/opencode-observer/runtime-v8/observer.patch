+  const order = new ModelPhaseOrder(),
+    input = safe(),
+    seen: string[] = []
+  const { ticket } = await run(order, input, [
+    (event) =>
+      Effect.sync(() => {
+        event.model_id = "after-first"
+        seen.push("first")
+      }),
+    (event) =>
+      Effect.sync(() => {
+        expect(event.model_id).toBe("after-first")
+        event.model_id = "after-last"
+        seen.push("last")
+      }),
+  ])
+  const lease = order.capture(
+    ticket,
+    challenge(),
+    () => input,
+    () => 1700000000000,
+  )
+  expect(seen).toEqual(["first", "last"])
+  expect(lease.receipt.phase).toBe("post-model-request-hooks")
+  expect(lease.receipt.projection.model_id).toBe("after-last")
+  expect(lease.receipt.complete).toBe(false)
+  expect(lease.receipt.phase_finality).toBe("unproven")
+  expect(lease.receipt.ordering_enforced).toBe(false)
+  expect(lease.receipt.provider_facts.entitlement).toBe("unknown")
+  expect(lease.receipt.financial_settings.observation).toBe("not_supplied")
+  expect(Date.parse(lease.receipt.valid_until) - Date.parse(lease.receipt.observed_at)).toBe(30000)
+  expect(lease.consume()).toEqual(lease.receipt)
+  expect(() => lease.consume()).toThrow("invalidated")
+})
