+"""Trusted canonical Store adapter for the actual authenticated owner check IPC.
+
+This publishes executed check windows, NOT Python Evidence or executable permits.
+The genuine verifier/financial/enrollment projections remain owned by Tessera.
+"""
+import http.client
+import json
+import socket
+from datetime import datetime
+
+from tessera_control.runtime_bindings import NativeCheckWindow
+from tessera_control.store import Forbidden
+
+
+def closed(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError()
+        result[key] = value
+    return result
+
+
+class _OwnerIPCConnection(http.client.HTTPConnection):
+    def __init__(self, socket_path):
+        super().__init__("owner.local", timeout=5)
+        self.socket_path = socket_path
+
+    def connect(self):
+        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self.sock.settimeout(self.timeout)
+        self.sock.connect(self.socket_path)
+
+
+class AuthenticatedOwnerCheckReader:
+    def __init__(self, socket_path, owner_handle):
+        if not isinstance(socket_path, str) or not socket_path.startswith("/") or not callable(getattr(owner_handle, "apply_existing_reader_authentication", None)):
+            raise Forbidden("owner_check_unavailable")
+        self.socket_path, self.owner = socket_path, owner_handle
+
+    def __call__(self, local_check_ref, quota_check_ref):
+        connection = _OwnerIPCConnection(self.socket_path)
+        try:
+            headers = {"Content-Type": "application/json", "Connection": "close"}
+            if self.owner.apply_existing_reader_authentication(headers) is not None:
+                raise ValueError()
+            connection.request("POST", "/resolve-native-check", json.dumps({
+                "local_check_ref": local_check_ref, "quota_check_ref": quota_check_ref,
+            }), headers)
+            response = connection.getresponse()
+            raw = response.read(32769)
+            if response.status != 200 or len(raw) > 32768:
+                raise ValueError()
+            return json.loads(raw, object_pairs_hook=closed)
+        except Exception:
+            raise Forbidden("owner_check_unavailable_or_revoked") from None
+        finally:
+            connection.close()
+
+
+class RegisteredOwnerCheckAdapter:
+    """Inject only via create_app(runtime_binding_adapter=), never request JSON.
+
+    validate_* callbacks belong to the independently approved enrolled owner; they
+    check actual launch/loaded artifacts, principal/session/publisher and native
+    immutable wire. Absence, booleans, async/unknown results deny. No defaults.
+    """
+    def __init__(self, *, reader, validate_enrollment, validate_allocation):
+        if not isinstance(reader, AuthenticatedOwnerCheckReader) or not callable(validate_enrollment) or not callable(validate_allocation):
+            raise Forbidden("owner_registration_unavailable")
+        self.reader = reader
+        self.enrollment = validate_enrollment
+        self.allocation = validate_allocation
+
+    def verify_enrollment(self, connection, actor, request, scope, pins):
+        if self.enrollment(connection, actor, request, scope, pins) is not None:
+            raise Forbidden("owner_enrollment_unavailable")
+
+    def verify_allocation(self, connection, actor, snapshot, request):
+        if self.allocation(connection, actor, snapshot, request) is not None:
+            raise Forbidden("owner_allocation_unavailable")
+
+    def verify_claim(self, connection, actor, operation, request):
+        self.verify_allocation(connection, actor, operation["binding"], operation["expected"])
+        proof = self.reader(request["local_check_ref"], request["quota_check_ref"])
+        expected_keys = {"publisher_ref", "local_check_ref", "quota_check_ref", "phase", "native_phase", "actor_credential_id",
+                         "scope_digest", "pins_digest", "request_ref", "final_fingerprint", "order_revision", "sequence",
+                         "operation_ref", "nonce", "session_ref", "executed_at", "local_checks", "quota", "provider_facts"}
+        if set(proof) != expected_keys or proof["publisher_ref"] != operation["binding"]["scope"]["publisher_ref"] or proof["phase"] != operation["expected"]["phase"] or proof["native_phase"] != operation["expected"]["native_phase"]:
+            raise Forbidden("owner_check_binding_mismatch")
+        local = proof["local_checks"]
+        if local != {"evidence_class": "local_measured_enforcement", "openai_only": "passed", "chatgpt_route": "passed",
+                     "chatgpt_oauth_method": "passed", "account_match": "passed", "api_key_overrides_absent": "passed"}:
+            raise Forbidden("owner_check_unknown")
+        if proof["quota"]["outcome"] != "passed" or proof["provider_facts"] != {
+            "evidence_class": "provider_unknown", "entitlement": "unknown", "billing_guarantee": "unknown",
+        }:
+            raise Forbidden("owner_check_unknown")
+        def timestamp(value):
+            result = datetime.fromisoformat(value.replace("Z", "+00:00"))
+            if result.tzinfo is None:
+                raise Forbidden("owner_check_time_unknown")
+            return result
+        return NativeCheckWindow(**{name: proof[name] for name in (
+            "local_check_ref", "quota_check_ref", "operation_ref", "actor_credential_id", "nonce",
+            "scope_digest", "pins_digest", "request_ref", "final_fingerprint", "order_revision", "sequence",
+        )}, checked_at=timestamp(proof["executed_at"]), snapshot_checked_at=timestamp(proof["quota"]["snapshot_checked_at"]),
+            valid_until=timestamp(proof["quota"]["valid_until"]))
