+test("secret getters outside projection are never traversed or hashed", async () => {
+  const input = safe(),
+    tool = input.tools[0]
+  let touched = 0
+  const trap = () => {
+    touched++
+    throw new Error("PRIVATE-CONTENT")
+  }
+  for (const field of ["headers", "body", "options", "accountID", "messages", "prompt"])
+    Object.defineProperty(input, field, { enumerable: true, get: trap })
+  for (const field of ["description", "default", "examples", "enum"])
+    Object.defineProperty(tool.inputSchema, field, { enumerable: true, get: trap })
+  const order = new ModelPhaseOrder(),
+    { ticket } = await run(order, input)
