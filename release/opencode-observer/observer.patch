+// Must be independently approved and invoked by the trusted embedding. This
+// publishes completed native guard operations, not independent auth or entitlement.
+export function createGuardCheckPublisher({ publisher_ref, issuer_origin, now = () => Date.now() }) {
+  if (typeof issuer_origin !== 'string') throw new Error('Guard publisher: origin string required.');
