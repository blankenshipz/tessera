+  if (context && (!isDigest(context.nonce) || !isDigest(context.session_ref) ||
+      !isDigest(context.proof_ref) || context.session_ref !== hash(session) ||
+      !Number.isSafeInteger(context.order_revision) || context.order_revision < 1 ||
+      !Number.isSafeInteger(context.sequence) || context.sequence < 1))
