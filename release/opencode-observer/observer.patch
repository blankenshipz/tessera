+import contextlib
+import io
+import json
+import sys
+import unittest
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+import codex_quota
+
+
+class ReceiptTests(unittest.TestCase):
+    def snapshot(self):
+        return {
+            "checked_at": (datetime.now(timezone.utc) - timedelta(seconds=1)).isoformat(),
+            "credit_risk": "none",
+            "buckets": [
+                {
+                    "windows": [
+                        {"reset": "known", "remaining_percent": 50, "target_used_percent": 50}
+                    ]
+                }
+            ],
+            "PRIVATE": "not-exported",
+        }
+
+    def call(self, snapshot, flags):
+        output = io.StringIO()
+        with (
+            patch.object(codex_quota, "read_quota", return_value=(snapshot, True)),
+            contextlib.redirect_stdout(output),
+        ):
+            status = codex_quota.main(flags)
+        return status, output.getvalue()
+
+    def test_same_actual_native_policy_and_snapshot_metadata(self):
+        data = self.snapshot()
+        status, output = self.call(data, ["--check", "--receipt"])
+        self.assertEqual(status, 0)
+        receipt = json.loads(output)
+        self.assertEqual(receipt["snapshot_checked_at"], data["checked_at"])
+        self.assertEqual(receipt["outcome"], "passed")
+        self.assertNotIn("PRIVATE", output)
+        self.assertNotIn("buckets", output)
+
+    def test_native_denial_not_relabelled_passed(self):
+        data = self.snapshot()
+        data["credit_risk"] = "purchased"
+        status, output = self.call(data, ["--check", "--receipt"])
+        self.assertEqual(status, 1)
+        self.assertEqual(json.loads(output)["outcome"], "denied")
+
+    def test_stale_and_future_snapshot_receipt_unavailable(self):
+        for seconds in [-31, 10]:
+            data = self.snapshot()
+            data["checked_at"] = (
+                datetime.now(timezone.utc) + timedelta(seconds=seconds)
+            ).isoformat()
+            status, output = self.call(data, ["--check", "--receipt"])
+            self.assertEqual(status, 2)
+            self.assertEqual(json.loads(output), {"outcome": "unavailable"})
+
+    def test_existing_check_stays_quiet(self):
+        status, output = self.call(self.snapshot(), ["--check"])
+        self.assertEqual((status, output), (0, ""))
+
+
+if __name__ == "__main__":
+    unittest.main()
