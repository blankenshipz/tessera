# Example unit; every path is a generic placeholder (see README.md).
# Contains no secrets: configuration and credentials are owner-only files
# referenced by path from /etc/tessera/salad-guardian.json.
[Unit]
Description=Tessera Salad safety guardian (supervised example)
PartOf=tessera.target
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=tessera
Group=tessera
UMask=0077
EnvironmentFile=-/etc/tessera/salad-guardian.env
StateDirectory=tessera
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tessera
ExecStart=/opt/tessera/.venv/bin/python -m tessera_control.salad_safety_service --run --config /etc/tessera/salad-guardian.json --health-file /var/lib/tessera/health/salad-guardian.json
Restart=on-failure
RestartSec=10
# Exit 2 means the operator's own configuration was refused (unknown or missing key, wrong type,
# an unsafe file it names); it will not fix itself, so it is not restarted. Any other failure
# (a key fetch that timed out at boot, a bind or TLS error, an error in the serve loop) exits 1
# and is restarted.
RestartPreventExitStatus=2
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/tessera

[Install]
WantedBy=tessera.target
