#!/usr/bin/env python3
"""Check a tessera.service-health.v1 file; exit 0 healthy, 1 stale/bad, 2 usage.

Usage: tessera-health-check HEALTH_FILE MAX_AGE_SECONDS

MAX_AGE_SECONDS must exceed the longest single step plus one poll interval: the
service writes the file between steps, never during one (the Salad executor's
route window is a long step). Standard library only; reads no secrets.
"""
import json
import sys
import time


def main(argv):
    if len(argv) != 3:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        max_age = float(argv[2])
        with open(argv[1], encoding="utf-8") as handle:
            doc = json.load(handle)
        age = time.time() - float(doc["last_loop_at"])
        state = doc.get("state")
        schema = doc.get("schema")
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"unhealthy: unreadable health file ({type(error).__name__})")
        return 1
    if schema != "tessera.service-health.v1" or state != "running" or not -max_age <= age <= max_age:
        print(f"unhealthy: state={state} age_seconds={age:.0f}")
        return 1
    print(f"healthy: age_seconds={age:.0f} loops={doc.get('loops')}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
