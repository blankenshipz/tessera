# Example unit; every path is a generic placeholder (see README.md).
# Manual start only: no [Install] section, so enabling or starting
# tessera.target never starts it. Contains no secret: the agent credential is
# an owner-only file passed with LoadCredential=.
# /etc/tessera must exist for the kill-switch marker; this unit does not create
# it, and a missing directory only makes the runner pause (safe).
[Unit]
Description=Tessera stuck-loop runner (admitted, manual start only)
After=network-online.target
Wants=network-online.target
# Admission: an operator creates this empty marker file to allow a start.
ConditionPathExists=/etc/tessera/stuck-loop.admitted
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=tessera
Group=tessera
UMask=0077
StateDirectory=tessera/stuck-loop
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tessera/stuck-loop
LoadCredential=agent-token:/etc/tessera/credentials/stuck-loop-agent-token
# Non-secret references only; %d is the unit's credentials directory.
Environment=TESSERA_CONTROL_URL=http://localhost:8080
Environment=TESSERA_AGENT_TOKEN_FILE=%d/agent-token
Environment=TESSERA_PROJECT_ID=example-project
Environment=TESSERA_AGENT_DESTINATION=example-destination
ExecStart=/opt/tessera/.venv/bin/tessera-stuck-loop --policy /etc/tessera/stuck-loop.json --journal /var/lib/tessera/stuck-loop/journal.jsonl --ledger /var/lib/tessera/stuck-loop/ledger.sqlite --kill-switch /etc/tessera/stuck-loop.kill --interval-seconds 120
# Exit 2 (configuration refused) and 3 (halted) will not fix themselves.
Restart=on-failure
RestartPreventExitStatus=2 3
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/tessera/stuck-loop
