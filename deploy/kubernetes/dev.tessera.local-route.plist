<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace __REPOSITORY__ with the absolute path of your Tessera checkout before installing. -->
<plist version="1.0"><dict>
  <key>Label</key><string>dev.tessera.local-route</string>
  <key>ProgramArguments</key><array>
    <string>__REPOSITORY__/.venv/bin/python</string>
    <string>-m</string><string>tessera_operator.route_supervisor</string>
  </array>
  <key>WorkingDirectory</key><string>__REPOSITORY__</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>AbandonProcessGroup</key><true/>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
