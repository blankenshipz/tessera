[Unit]
Description=Tessera independent control plane (loopback)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/tessera-control/tessera.sqlite3

[Service]
Type=simple
User=tessera-control
Group=tessera-control
UMask=0077
StateDirectory=tessera-control
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tessera-control
ExecStart=/opt/tessera/venv/bin/tessera serve --state-dir /var/lib/tessera-control --bind-host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/tessera-control

[Install]
WantedBy=multi-user.target
