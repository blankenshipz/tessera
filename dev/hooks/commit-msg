#!/bin/sh
# Reject commit messages that carry links to private tool or agent sessions
# (for example a `Claude-Session:` trailer or a claude.ai/code URL). Commit
# messages are published with the history and cannot be fixed without a rewrite.
# Install: ln -s ../../dev/hooks/commit-msg .git/hooks/commit-msg
# (or copy it into your hooks directory if you use core.hooksPath).
msg_file="$1"
if grep -Eiq '^[[:space:]]*[A-Za-z-]*-Session:[[:space:]]*https?://|https?://claude\.ai/code' "$msg_file"; then
  echo "commit-msg: remove private session links (e.g. 'Claude-Session:' trailers) from the message." >&2
  exit 1
fi
exit 0
