{
  "name": "tessera-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "files": [
    "*.mjs",
    "*.js",
    "*.cjs",
    "*.html",
    "*.css"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "check": "node --check main.mjs && node --check renderer.mjs && node --check connection.mjs && node --check control-credential.mjs && node --check appearance.js",
    "test:native-screen": "electron test/electron-screen-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
